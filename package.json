{
  "name": "sqc-nodejs-demo",
  "version": "0.0.0",
  "private": true,
  "main": "src/server/index.js",
  "scripts": {
    "start": "NODE_ENV=production tsx ./bin/www",
    "dev": "concurrently \"vite\" \"NODE_ENV=development DEBUG=sqc_app* nodemon --exec tsx --ext js,ts,json ./bin/www\"",
    "build": "vite build",
    "build:image": "vite build && cp -r src/client/assets/images/* dist/assets/",
    "build:server": "tsc --project tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "DB_CLIENT=sqlite3 DB_FILENAME=test.db NODE_ENV=development mocha specs/**/*",
    "test:pg": "NODE_ENV=development mocha specs/**/*",
    "create-merchant": "node scripts/create-merchant.js",
    "screenshots:merchant": "node scripts/capture-merchant-screenshots.js",
    "screenshots:i18n": "node scripts/capture-i18n-screenshots.js",
    "db:migrate": "knex migrate:latest --knexfile db/knexfile.js",
    "db:migrate:rollback": "knex migrate:rollback --knexfile db/knexfile.js",
    "db:seed": "knex seed:run --knexfile db/knexfile.js",
    "db:seed:menus": "knex seed:run --specific=07_menus.js --knexfile db/knexfile.js",
    "db:reset": "knex migrate:rollback --all --knexfile db/knexfile.js && knex migrate:latest --knexfile db/knexfile.js && knex seed:run --knexfile db/knexfile.js"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "camelcase-keys": "^6.2.2",
    "chai": "^4.5.0",
    "cookie-parser": "~1.4.7",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^3.2.0",
    "debug": "~4.4.3",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "~4.21.0",
    "history": "^5.3.0",
    "http-errors": "~2.0.1",
    "i18next": "^25.8.13",
    "knex": "^0.20.15",
    "lodash": "^4.18.1",
    "mocha": "^11.0.0",
    "morgan": "~1.10.1",
    "pg": "^8.20.0",
    "react": "^16.14.0",
    "react-bootstrap": "^1.6.8",
    "react-dom": "^16.14.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^5.3.4",
    "sqlite3": "^5.1.7",
    "tsx": "^4.21.0",
    "uuid": "^13.0.1"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.14",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  },
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sqlite3"
    ]
  }
}
