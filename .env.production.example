# Production environment (Railway + Neon/Supabase Postgres)
NODE_ENV=production
PORT=3000

# From Neon or Supabase dashboard (includes sslmode=require)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/eggrollpos?sslmode=require

# Optional: force SSL on or off (auto-detected for Neon/Supabase)
# DATABASE_SSL=true

# Public URL after Railway assigns a domain
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Optional: skip migrate-on-start if Railway release command runs migrations
# SKIP_MIGRATIONS=1

# Railway Object Storage (S3-compatible) — public bucket for menu item images
# Railway provides these when you attach Object Storage to the service.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional override for public image URLs (defaults to ENDPOINT/BUCKET)
# S3_PUBLIC_URL=
